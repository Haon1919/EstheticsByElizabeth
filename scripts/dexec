#!/bin/bash

# Configuration
CONTAINER_NAME="esthetics-api"
COMPOSE_FILE="docker/docker-compose.yml"
SERVICE_NAME="api"

# Function to check if container is running
is_container_running() {
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        return 0
    else
        return 1
    fi
}

# Ensure container is running
ensure_container() {
    if ! is_container_running; then
        echo "Container ${CONTAINER_NAME} is not running. Starting services..."
        docker compose -f "${COMPOSE_FILE}" up -d "${SERVICE_NAME}"
        
        echo "Waiting for container to be ready..."
        # simple wait loop, could be improved with healthchecks if configured
        sleep 5
    fi
}

# Main execution
ensure_container

if [ $# -eq 0 ]; then
    # No arguments, start interactive shell
    echo "Starting interactive shell in ${CONTAINER_NAME}..."
    docker exec -it "${CONTAINER_NAME}" /bin/bash
else
    # Arguments provided, execute command
    # Using "$@" to preserve argument quoting
    docker exec -i "${CONTAINER_NAME}" "$@"
fi
