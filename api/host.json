{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "Default": "Information",
      "Microsoft.Azure.Functions.Worker": "Warning",
      "Function.ScheduleAppointment": "Debug"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api"
    }
  },
  "functionTimeout": "00:10:00",
  "_comment_cors": "In production (Azure Static Web Apps), CORS is handled automatically by the SWA reverse proxy. Do NOT deploy wildcard CORS settings to production."
}